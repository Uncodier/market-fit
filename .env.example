# Shiplight API token
# Get yours at https://app.shiplight.ai/api-tokens
# If set, no AI provider API key required.
# SHIPLIGHT_API_TOKEN=

# AppSumo Licensing
APPSUMO_CLIENT_ID=
APPSUMO_CLIENT_SECRET=
APPSUMO_API_KEY=
APPSUMO_REDIRECT_URI=

# Shared Upstash request admission and cache control plane.
# Include authentication in the URL, for example:
# rediss://default:TOKEN@INSTANCE.upstash.io:6379
REDIS_URL=
# Set to true only after the Redis integration is configured and monitored.
REDIS_REQUIRED=false
ANALYTICS_MAX_RANGE_DAYS=93
ASSET_PROXY_MAX_BYTES=26214400

# Twilio webhook validation
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_WEBHOOK_URL=

# Cloudflare OAuth
CLOUDFLARE_CLIENT_ID=
CLOUDFLARE_CLIENT_SECRET=

# Vercel API
VERCEL_API_TOKEN=
VERCEL_PROJECT_ID=
VERCEL_TEAM_ID=

# AI provider API key (optional with SHIPLIGHT_API_TOKEN).

# GOOGLE_API_KEY=          # default model: gemini-3.1-pro-preview
# ANTHROPIC_API_KEY=       # default model: claude-haiku-4-5
# OPENAI_API_KEY=          # default model: gpt-5.4-mini

# Optional: override the default AI model.
# WEB_AGENT_MODEL=claude-sonnet-4-6

# External API server. It owns Temporal workflows and Zavu credentials.
# Never expose the Zavu API key through a NEXT_PUBLIC_* variable.
NEXT_PUBLIC_API_SERVER_URL=http://localhost:3001
API_SERVER_URL=http://localhost:3001
SERVICE_API_KEY=

# Required for authenticated E2E runs; auth.setup creates a fresh storage state.
TEST_ADMIN_EMAIL=
TEST_ADMIN_PASSWORD=

# Deterministic E2E workspace selection
TEST_SITE_NAME=
TEST_SITE_ID=
TEST_CATALOG_CATEGORY_NAME=
TEST_RECORD_CATEGORY_NAME=
TEST_CAMPAIGN_NAME=

# Explicit E2E target. Smoke is read-only; unspecified targets fail before login.
TEST_TARGET=
TEST_SUITE=smoke
TEST_BASE_URL=
TEST_COMMERCE_BASE_URL=
TEST_DEPLOYED_SHA=
TEST_SHOP_SLUG=
TEST_CATALOG_ITEM_ID=
TEST_CATALOG_ITEM_NAME=
TEST_CONTENT_NAME=
TEST_LEAD_NAME=
# These flags NEVER enable production mutations.
TEST_ALLOW_MUTATIONS=0
TEST_DISPOSABLE_ENVIRONMENT=0
TEST_SUPABASE_URL=
TEST_SUPABASE_PROJECT_REF=
TEST_SUPABASE_ANON_KEY=
TEST_AGENT_ID=
TEST_INVITE_EMAIL_DOMAIN=
TEST_BUYER_EMAIL=
TEST_BUYER_PASSWORD=
TEST_COLLABORATOR_EMAIL=
TEST_COLLABORATOR_PASSWORD=
TEST_MARKETING_EMAIL=
TEST_MARKETING_PASSWORD=
TEST_FOREIGN_EMAIL=
TEST_FOREIGN_PASSWORD=
TEST_FOREIGN_SITE_ID=
TEST_COMPANY_NAME=
TEST_EXPENSE_ACCOUNT_NAME=
TEST_CALENDAR_MEMBER_EMAIL=
TEST_RESERVABLE_ITEM_ID=
TEST_RESERVATION_SCHEDULE_ID=
TEST_LEAD_ID=
TEST_CAMPAIGN_ID=
TEST_RESERVATION_CUSTOMER_ID=
TEST_RESERVATION_CUSTOMER_NAME=
TEST_AGENT_STORAGE_STATE=

# Lifetime for newly issued public document links (1-365 days).
PUBLIC_DOCUMENT_TOKEN_TTL_DAYS=30

# Additional trusted Stripe checkout return origins, comma-separated.
# Add every custom storefront origin explicitly; wildcard subdomains are not accepted.
CHECKOUT_RETURN_ORIGINS=
