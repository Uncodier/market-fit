# Shiplight API token
# Get yours at https://nova.shiplight.ai/api-tokens
# If set, no AI provider API key required.
# SHIPLIGHT_API_TOKEN=

# AppSumo Licensing
APPSUMO_CLIENT_ID=
APPSUMO_CLIENT_SECRET=
APPSUMO_API_KEY=
APPSUMO_REDIRECT_URI=

# Cloudflare OAuth
CLOUDFLARE_CLIENT_ID=
CLOUDFLARE_CLIENT_SECRET=

# Vercel API
VERCEL_API_TOKEN=
VERCEL_PROJECT_ID=
VERCEL_TEAM_ID=

# AI provider API key (optional with SHIPLIGHT_API_TOKEN).

# GOOGLE_API_KEY=          # default model: gemini-3.1-pro-preview
# ANTHROPIC_API_KEY=       # default model: claude-haiku-4-5
# OPENAI_API_KEY=          # default model: gpt-5.4-mini

# Optional: override the default AI model.
# WEB_AGENT_MODEL=claude-sonnet-4-6

# External API server. It owns Temporal workflows and Zavu credentials.
# Never expose the Zavu API key through a NEXT_PUBLIC_* variable.
NEXT_PUBLIC_API_SERVER_URL=http://localhost:3001
API_SERVER_URL=http://localhost:3001
SERVICE_API_KEY=

# Required for authenticated E2E runs; auth.setup creates a fresh storage state.
TEST_ADMIN_EMAIL=
TEST_ADMIN_PASSWORD=

# Deterministic E2E workspace selection
TEST_SITE_NAME=
TEST_CATALOG_CATEGORY_NAME=
TEST_RECORD_CATEGORY_NAME=
TEST_CAMPAIGN_NAME=

# Lifetime for newly issued public document links (1-365 days).
PUBLIC_DOCUMENT_TOKEN_TTL_DAYS=30

# Additional trusted Stripe checkout return origins, comma-separated.
# Add every custom storefront origin explicitly; wildcard subdomains are not accepted.
CHECKOUT_RETURN_ORIGINS=
