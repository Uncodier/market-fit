{
  "build": {
    "env": {
      "NEXT_RUNTIME": "nodejs",
      "NEXT_PRIVATE_TARGET": "server"
    }
  },
  "framework": "nextjs",
  "regions": ["cdg1"],
  "crons": [
    {
      "path": "/api/cron/record-embeddings",
      "schedule": "*/5 * * * *"
    }
  ],
  "buildCommand": "npm run build"
} 